<Window x:Class="PeakMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter" Width="820" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="nav" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="12,8" Margin="0,0,0,2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,12,0"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A7FD8F2" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#557FD8F2" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyBox" TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="16,12,10,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{local:T De=Einstellungen, En=Settings}" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right" Width="28" Height="28" />
            </Grid>

            <Grid Grid.Row="1" Margin="12,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <StackPanel Margin="0,0,12,0">
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE9E9;" Content="{local:T De=Allgemein, En=General}" Checked="Nav_Checked" CommandParameter="general" IsChecked="True" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE7C1;" Content="{local:T De=Kampf, En=Combat}" Checked="Nav_Checked" CommandParameter="combat" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="{local:T De=Anzeige, En=Display}" Checked="Nav_Checked" CommandParameter="display" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE737;" Content="{local:T De=Overlay-Verhalten, En='Overlay behaviour'}" Checked="Nav_Checked" CommandParameter="overlay" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE767;" Content="{local:T De=Audio, En=Audio}" Checked="Nav_Checked" CommandParameter="audio" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xEA8F;" Content="{local:T De='Hinweise &amp; Events', En='Alerts &amp; events'}" Checked="Nav_Checked" CommandParameter="events" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE765;" Content="{local:T De=Tastenbelegung, En=Hotkeys}" Checked="Nav_Checked" CommandParameter="keys" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE81C;" Content="{local:T De=Änderungsprotokoll, En=Changelog}" Checked="Nav_Checked" CommandParameter="changes" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xEBE8;" Content="{local:T De=Debug, En=Debug}" Checked="Nav_Checked" CommandParameter="debug" />
                    <Border Height="1" Background="{StaticResource Edge}" Margin="6,8,6,8" />
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xEB51;" Foreground="#FF8A9B" Content="{local:T De=Unterstützen, En=Support}" Checked="Nav_Checked" CommandParameter="support" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Edge}" />

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
                    <Grid>
                        <!-- GENERAL -->
                        <StackPanel x:Name="PageGeneral">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De='REGION UND SPRACHE', En='REGION AND LANGUAGE'}" />
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,230,0">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=Region, En=Region}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Server-Zeit der Event-Timer und Profil-Links auf aion2index.com.', En='Server time of the event timers and profile links on aion2index.com.'}" />
                                </StackPanel>
                                <WrapPanel x:Name="RegionChips" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="330">
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=Europa, En=Europe}" Tag="eu" Click="Region_Click" Margin="4,0,0,4" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=NA-Ost, En='NA East'}" Tag="nae" Click="Region_Click" Margin="4,0,0,4" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=NA-West, En='NA West'}" Tag="naw" Click="Region_Click" Margin="4,0,0,4" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=Korea, En=Korea}" Tag="kr" Click="Region_Click" Margin="4,0,0,4" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=Taiwan, En=Taiwan}" Tag="tw" Click="Region_Click" Margin="4,0,0,4" />
                                </WrapPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=Sprache, En=Language}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Oberfläche, Skill- und Boss-Namen. PeakMeter startet dafür kurz neu.', En='Interface, skill and boss names. PeakMeter restarts briefly.'}" />
                                    <WrapPanel x:Name="LangChips" HorizontalAlignment="Left" Margin="-4,8,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=START, En=STARTUP}" />
                            <CheckBox x:Name="Autostart" Style="{StaticResource Switch}" Click="Autostart_Click" Content="{local:T De='Mit Windows starten', En='Start with Windows'}" />
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=UPDATES, En=UPDATES}" Margin="0,16,0,8" />
                            <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Updates automatisch installieren', En='Install updates automatically'}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Chip}" Height="26" Click="CheckUpdate_Click" Content="{local:T De='Nach Updates suchen', En='Check for updates'}" />
                                <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- COMBAT -->
                        <StackPanel x:Name="PageCombat" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=KÄMPFE, En=FIGHTS}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De='Inaktivitäts-Timeout', En='Idle timeout'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Wie lange niemand Schaden machen darf, bevor der Kampf endet. Bei lebendem Boss wartet PeakMeter länger.', En='How long nobody may deal damage before the fight ends. With a boss alive PeakMeter waits longer.'}" />
                                </StackPanel>
                                <Slider x:Name="IdleSlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="3" Maximum="60" IsMoveToPointEnabled="True" VerticalAlignment="Top" Margin="10,2,0,0" ValueChanged="Idle_Changed" />
                                <TextBlock x:Name="IdleText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,230,0">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=Zielmodus, En='Target mode'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Nur Bosse: nur Schaden an Bossen zählt (ohne Boss alles).', En='Bosses only: only damage to bosses counts (without a boss, everything).'}" />
                                </StackPanel>
                                <StackPanel x:Name="TargetChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De='Nur Bosse', En='Bosses only'}" Tag="boss" Click="Target_Click" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De='Alle Ziele', En='All targets'}" Tag="all" Click="Target_Click" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="PartyOnly" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Nur mich bzw. meine Gruppe erfassen', En='Only me / my party'}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Fremde in der Nähe werden ignoriert. PeakMeter sollte laufen, wenn du dich teleportierst oder einer Gruppe beitrittst.', En='Strangers nearby are ignored. Keep PeakMeter running when you teleport or join a party.'}" />
                        </StackPanel>

                        <!-- DISPLAY -->
                        <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=WERTE, En=VALUES}" />
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,180,0">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=DPS-Berechnung, En='DPS calculation'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='eDPS teilt durch die ganze Kampfzeit. aDPS nur durch deine aktive Zeit, vom ersten bis zum letzten Treffer.', En='eDPS divides by the whole fight. aDPS only by your active time, from your first to your last hit.'}" />
                                </StackPanel>
                                <StackPanel x:Name="DpsChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Chip}" Height="26" Content="eDPS" Tag="e" Click="Dps_Click" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="aDPS" Tag="a" Click="Dps_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,260,0">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=Wert-Chip, En='Value chip'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Welche Zahl neben jedem Spieler steht.', En='Which number stands next to each player.'}" />
                                </StackPanel>
                                <StackPanel x:Name="ChipChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=Kampfkraft, En='Combat power'}" Tag="cp" Click="Chip_Click" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="Gearscore" Tag="gs" Click="Chip_Click" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=Aus, En=Off}" Tag="none" Click="Chip_Click" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ShowTotal" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Gesamtschaden neben der DPS anzeigen', En='Show total damage next to DPS'}" />
                            <CheckBox x:Name="HideNames" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Spielernamen ausblenden (Klassenname statt Name, z. B. für Streams)', En='Hide player names (class instead, e.g. for streams)'}" />
                            <CheckBox x:Name="ShowPortrait" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Eigenes Charakterbild statt Klassen-Logo anzeigen', En='Show your character portrait instead of the class emblem'}" />
                            <CheckBox x:Name="Compact" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Kompakte Zeilen', En='Compact rows'}" />
                            <Grid Style="{StaticResource Row}" Margin="0,10,0,14">
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De=Zeitformat, En='Time format'}" />
                                <StackPanel x:Name="ClockChips" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De='24 Stunden', En='24 hours'}" Tag="24" Click="Clock_Click" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De='12 Stunden', En='12 hours'}" Tag="12" Click="Clock_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,220,0">
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De='Format der Zusammenfassung', En='Summary format'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Was der Kopieren-Knopf in die Zwischenablage legt.', En='What the copy button puts on the clipboard.'}" />
                                </StackPanel>
                                <StackPanel x:Name="SummaryChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De='Eine Zeile', En='One line'}" Tag="one" Click="Summary_Click" Margin="0,0,4,0" />
                                    <Button Style="{StaticResource Chip}" Height="26" Content="{local:T De=Mehrzeilig, En=Multi-line}" Tag="multi" Click="Summary_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Section}" Text="OVERLAY" Margin="0,8,0,8" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De=Hintergrund-Deckkraft, En='Background opacity'}" />
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="20" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="Opacity_Changed" />
                                <TextBlock x:Name="OpacityText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De=UI-Skalierung, En='UI scale'}" />
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="70" Maximum="160" IsMoveToPointEnabled="True" ValueChanged="Scale_Changed" />
                                <TextBlock x:Name="ScaleText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=Aktualisierungsrate, En='Refresh rate'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Niedriger = flüssiger, aber mehr CPU.', En='Lower = smoother, but more CPU.'}" />
                                </StackPanel>
                                <Slider x:Name="RefreshSlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="100" Maximum="1000" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" TickFrequency="50" IsMoveToPointEnabled="True" VerticalAlignment="Top" Margin="0,2,0,0" ValueChanged="Refresh_Changed" />
                                <TextBlock x:Name="RefreshText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- OVERLAY BEHAVIOUR -->
                        <StackPanel x:Name="PageOverlay" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=OVERLAY-VERHALTEN, En='OVERLAY BEHAVIOUR'}" />
                            <CheckBox x:Name="FocusMode" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De=Fokusmodus, En='Focus mode'}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,60,12" Text="{local:T De='Blendet im Kampf die Kopfzeile aus. Mit der Maus darüber erscheint sie wieder.', En='Hides the header during fights. Hover the meter to bring it back.'}" />
                            <CheckBox x:Name="FadeIdle" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Bei Leerlauf verblassen', En='Fade when idle'}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,60,12" Text="{local:T De='Eine Minute ohne Kampf wird das Overlay blass, bis zum nächsten Kampf oder bis die Maus darauf zeigt.', En='After a minute without a fight the overlay fades until the next fight or until you hover it.'}" />
                            <CheckBox x:Name="OnlyOverGame" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Nur über dem Spiel', En='Only over the game'}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,60,12" Text="{local:T De='Das Overlay ist nur zu sehen, solange Aion 2 im Vordergrund ist.', En='The overlay only shows while AION 2 is in front.'}" />
                            <CheckBox x:Name="RememberClick" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Durchklicken merken', En='Remember click-through'}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,60,12" Text="{local:T De='Beim Start bleibt Durchklicken so, wie du es zuletzt gelassen hast.', En='On start, click-through stays as you left it.'}" />
                            <CheckBox x:Name="HideClosed" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Ausblenden, wenn das Spiel geschlossen ist', En='Hide while the game is closed'}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,60,12" Text="{local:T De='Das Overlay kommt von selbst zurück, sobald Aion 2 startet.', En='The overlay comes back by itself when AION 2 starts.'}" />
                        </StackPanel>

                        <!-- AUDIO -->
                        <StackPanel x:Name="PageAudio" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=LAUTSTÄRKE, En=VOLUME}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{local:T De=Hinweis-Ton, En='Alert chime'}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Events, Weltbosse, Energie.', En='Events, world bosses, energy.'}" />
                                </StackPanel>
                                <Slider x:Name="Volume" Grid.Column="1" Style="{StaticResource Slim}" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" VerticalAlignment="Top" Margin="0,2,0,0" ValueChanged="Volume_Changed" />
                                <TextBlock x:Name="VolumeText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <Button Grid.Column="3" Style="{StaticResource Chip}" Height="24" Margin="8,0,0,0" VerticalAlignment="Top" Click="TestSound_Click" Content="{local:T De=Testen, En=Test}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{local:T De='Zwei weiche Glockentöne, auch bei 100 % nach oben begrenzt – tut nicht in den Ohren weh.', En='Two soft bell tones, capped even at 100 % – easy on the ears.'}" />
                        </StackPanel>

                        <!-- ALERTS & EVENTS -->
                        <StackPanel x:Name="PageEvents" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=HINWEISE, En=ALERTS}" />
                            <CheckBox x:Name="ToastsOn" Style="{StaticResource Switch}" Click="Toggle_Click" Content="{local:T De='Hinweise rechts am Bildschirmrand einblenden', En='Slide alerts in at the right edge'}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,60,12" Text="{local:T De='Aus: der Hinweis erscheint als Banner im Overlay.', En='Off: the alert shows as a banner in the overlay.'}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De=Anzeigedauer, En=Duration}" />
                                <Slider x:Name="ToastSlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="4" Maximum="20" IsMoveToPointEnabled="True" ValueChanged="Toast_Changed" />
                                <TextBlock x:Name="ToastText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=VORLAUF, En='LEAD TIME'}" Margin="0,8,0,8" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Events" />
                                <Slider x:Name="LeadSlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" ValueChanged="Lead_Changed" />
                                <TextBlock x:Name="LeadText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De=Weltbosse, En='World bosses'}" />
                                <Slider x:Name="BossLeadSlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" ValueChanged="BossLead_Changed" />
                                <TextBlock x:Name="BossLeadText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Chip}" Height="26" Click="OpenTimers_Click" Content="{local:T De='Event-Timer öffnen', En='Open event timers'}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource Chip}" Height="26" Click="TestToast_Click" Content="{local:T De='Test-Hinweis', En='Test alert'}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- HOTKEYS -->
                        <StackPanel x:Name="PageKeys" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De='GLOBALE TASTENKÜRZEL', En='GLOBAL HOTKEYS'}" />
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De='Overlay zeigen / verstecken', En='Show / hide overlay'}" />
                                <TextBox x:Name="KeyToggle" Style="{StaticResource KeyBox}" HorizontalAlignment="Right" PreviewKeyDown="Key_Down" Tag="toggle" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De='Kampf zurücksetzen', En='Reset fight'}" />
                                <TextBox x:Name="KeyReset" Style="{StaticResource KeyBox}" HorizontalAlignment="Right" PreviewKeyDown="Key_Down" Tag="reset" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De='Zusammenfassung kopieren', En='Copy summary'}" />
                                <TextBox x:Name="KeyCopy" Style="{StaticResource KeyBox}" HorizontalAlignment="Right" PreviewKeyDown="Key_Down" Tag="copy" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource Label}" Text="{local:T De='Durchklicken umschalten', En='Toggle click-through'}" />
                                <TextBox x:Name="KeyClick" Style="{StaticResource KeyBox}" HorizontalAlignment="Right" PreviewKeyDown="Key_Down" Tag="click" />
                            </Grid>
                            <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}" Text="{local:T De='Feld anklicken und die Kombination drücken. Entf löscht.', En='Click a field and press the combination. Delete clears it.'}" />
                        </StackPanel>

                        <!-- CHANGELOG -->
                        <StackPanel x:Name="PageChanges" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=ÄNDERUNGSPROTOKOLL, En=CHANGELOG}" />
                            <TextBlock x:Name="ChangesText" Foreground="{StaticResource TextSoft}" FontSize="11.5" TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>

                        <!-- SUPPORT -->
                        <StackPanel x:Name="PageSupport" Visibility="Collapsed">
                            <Border CornerRadius="14" Padding="22,20" Margin="0,4,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#33FF5E5B" Offset="0" />
                                        <GradientStop Color="#1A7FD8F2" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SupportTitle" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SupportSub" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="SupportBody" Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="19" />
                                    <Button Click="Kofi_Click" Margin="0,18,0,0" HorizontalAlignment="Left" Cursor="Hand" Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" CornerRadius="10" Background="#FF5E5B" Padding="20,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14" Margin="0,1,10,0" />
                                                        <ContentPresenter TextElement.Foreground="White" TextElement.FontSize="13" TextElement.FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#FF7774" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock x:Name="SupportButton" />
                                    </Button>
                                    <TextBlock Text="ko-fi.com/peakmeter" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,8,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SupportFreeHead" Style="{StaticResource Section}" />
                            <TextBlock x:Name="SupportFree" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Style="{StaticResource Chip}" Height="28" Margin="0,0,6,6" Click="CopyLink_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" /><TextBlock x:Name="CopyLinkLabel" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Chip}" Height="28" Margin="0,0,6,6" Click="GitHub_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" /><TextBlock x:Name="StarLabel" /></StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="CopyLinkText" Style="{StaticResource Hint}" />
                        </StackPanel>

                        <!-- DEBUG -->
                        <StackPanel x:Name="PageDebug" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Section}" Text="STATUS" />
                            <TextBlock x:Name="DebugStatus" Foreground="{StaticResource TextSoft}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <TextBlock Style="{StaticResource Section}" Text="{local:T De=WERKZEUGE, En=TOOLS}" />
                            <WrapPanel>
                                <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,6,6" Click="OpenFolder_Click" Content="{local:T De='Daten-Ordner öffnen', En='Open data folder'}" />
                                <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,6,6" Click="OpenLog_Click" Content="{local:T De='Protokoll öffnen', En='Open log'}" />
                                <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,6,6" Click="Demo_Click" Content="{local:T De=Demo-Kampf, En='Demo fight'}" />
                                <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,6,6" Click="Energy_Click" Content="{local:T De=Odyle-Energie, En='Odyle energy'}" />
                                <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,6,6" Click="GearProbe_Click" Content="{local:T De='Gearscore &amp; CP finden', En='Find gear score &amp; CP'}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="16,8,12,10">
                <Grid>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Chip}" Height="24" Margin="0,0,6,0" Click="GitHub_Click" Background="Transparent">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" /><TextBlock Text="GitHub" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Height="24" Margin="0,0,6,0" Click="Bug_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" /><TextBlock Text="{local:T De='Fehler melden', En='Report a bug'}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Height="24" Margin="0,0,6,0" Click="Idea_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" /><TextBlock Text="{local:T De='Funktion vorschlagen', En='Suggest a feature'}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Height="24" Click="Kofi_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" Foreground="#FF6B81" Margin="0,1,6,0" /><TextBlock Text="{local:T De='Unterstütze PeakMeter', En='Support PeakMeter'}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
