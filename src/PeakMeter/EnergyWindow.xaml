<Window x:Class="PeakMeter.EnergyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter – Odyle-Energie" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,16">
        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{local:T De='Odyle-Energie', En='Odyle energy'}" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right"
                        Width="28" Height="28" ToolTip="{local:T De='Schließen', En='Close'}" />
            </Grid>

            <!-- Big number and bar -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ValueText" Text="–" Foreground="{StaticResource Text}" FontSize="34" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="CapText" Text="/ 560" Foreground="{StaticResource TextDim}" FontSize="16" VerticalAlignment="Bottom"
                           Margin="6,0,0,7" />
            </StackPanel>
            <Border x:Name="Track" Height="6" CornerRadius="3" Background="{StaticResource Track}" Margin="0,6,0,0">
                <Border x:Name="Fill" HorizontalAlignment="Left" CornerRadius="3" Width="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7FD8F2" Offset="0" />
                            <GradientStop Color="#B07CF0" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
            <TextBlock x:Name="InfoText" Foreground="{StaticResource TextSoft}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ClaimsText" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0" />
            <TextBlock x:Name="SourceText" FontSize="10.5" Margin="0,6,0,0" />

            <!-- Quick changes -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource Chip}" Height="26" Click="Spend_Click" Margin="0,0,6,0" ToolTip="{local:T De='Belohnung geöffnet (−40)', En='Reward opened (−40)'}">
                    <TextBlock Text="{local:T De='−40  Belohnung', En='−40  reward'}" />
                </Button>
                <Button Style="{StaticResource Chip}" Height="26" Click="Plus10_Click" Margin="0,0,6,0" ToolTip="{local:T De='Kleine Odyle-Energie benutzt', En='Small Odyle energy used'}">
                    <TextBlock Text="+10" />
                </Button>
                <Button Style="{StaticResource Chip}" Height="26" Click="Plus40_Click" ToolTip="{local:T De='Odyle-Energie (Trank) benutzt', En='Odyle energy (potion) used'}">
                    <TextBlock Text="+40" />
                </Button>
            </StackPanel>

            <!-- Exact value -->
            <TextBlock Text="{local:T De='Wert aus dem Spiel eintragen', En='Enter the value from the game'}" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                    <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White"
                             FontSize="13" Padding="8,4" KeyDown="Input_KeyDown" />
                </Border>
                <Button Grid.Column="1" Style="{StaticResource Chip}" Height="28" Margin="8,0,0,0" Click="Apply_Click">
                    <TextBlock Text="{local:T De='Übernehmen', En='Apply'}" />
                </Button>
            </Grid>

            <Button x:Name="QuaiButton" Style="{StaticResource Chip}" Height="26" Margin="0,12,0,0" HorizontalAlignment="Left" Click="Quai_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="QuaiCheck" FontFamily="{StaticResource IconFont}" Text="&#xE739;" Margin="0,1,6,0" />
                    <TextBlock Text="{local:T De='Quai-Mitgliedschaft (max. 840)', En='Quai membership (max. 840)'}" />
                </StackPanel>
            </Button>

            <TextBlock Foreground="{StaticResource TextDim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="{local:T De='PeakMeter zählt ab deinem Wert selbst weiter (+15 alle 3 h) und klingelt, wenn die Energie voll ist – damit nichts verfällt.', En='PeakMeter counts on from your value (+15 every 3 h) and chimes when the energy is full – so nothing is wasted.'}" />

            <!-- Helping PeakMeter learn where the game sends the energy -->
            <Border x:Name="ProbeBox" CornerRadius="8" Background="#147FD8F2" BorderBrush="#337FD8F2" BorderThickness="1" Padding="12,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{local:T De='Automatisch erkennen (Beta)', En='Detect automatically (beta)'}" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProbeStep" Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="{local:T De='Hilf PeakMeter, die Energie im Spiel zu finden. Dauert 2 Minuten, bleibt auf deinem PC.', En='Help PeakMeter find the energy in the game data. Takes 2 minutes, stays on your PC.'}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ProbeButton" Style="{StaticResource Chip}" Height="26" Click="Probe_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ProbeIcon" Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" Foreground="#FF6B81" />
                                <TextBlock x:Name="ProbeLabel" Text="{local:T De='Los geht\'s', En='Let\'s go'}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ProbeStatus" Foreground="{StaticResource TextDim}" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
