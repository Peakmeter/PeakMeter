<Window x:Class="PeakMeter.PetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter – Pets" Width="640" Height="620" MinWidth="480" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="PetTemplate">
            <Grid Height="44" Margin="0,0,0,3">
                <Border x:Name="Bg" CornerRadius="8" Background="#0AFFFFFF" />
                <Border CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left" Background="{Binding GenusBrush}" />
                <Grid Margin="12,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Genus}" Foreground="{Binding GenusBrush}" FontSize="10" Margin="8,2,0,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE707;" Width="20" Height="18" Margin="6,0,0,0" Click="Map_Click" Tag="{Binding Url}"
                                    Visibility="{Binding UrlVisible}" ToolTip="{local:T De='Wo es droppt, auf der Karte (aion2timers.com)', En='Where it drops, on the map (aion2timers.com)'}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Where}" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding WhereAll}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Souls}" Foreground="{StaticResource Text}" FontSize="12" HorizontalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Track}" Margin="6,4,6,0">
                            <Border HorizontalAlignment="Left" CornerRadius="2" Width="{Binding Bar}" Background="{Binding GenusBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Left" Grid.Column="3" Text="{Binding Left}" Foreground="{Binding LevelBrush}" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Full}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#06FFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- a monster on this map whose souls you still need -->
        <DataTemplate x:Key="AreaTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Monster}" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding Pets}" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Where}" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                    <Border CornerRadius="6" Background="#2240C080" Padding="7,2" HorizontalAlignment="Right" Visibility="{Binding NearVisible}">
                        <TextBlock Text="{Binding Near}" Foreground="#5CD08A" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                    <Button Style="{StaticResource Chip}" Height="22" Margin="0,4,0,0" HorizontalAlignment="Right" Click="Map_Click" Tag="{Binding Url}"
                            Visibility="{Binding UrlVisible}" ToolTip="{local:T De='Alle Spawns dieses Monsters auf der Karte (aion2timers.com)', En='Every spawn of this monster on the map (aion2timers.com)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" Margin="0,1,5,0" />
                            <TextBlock Text="{local:T De=Karte, En=Map}" FontSize="10.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource PawIcon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Pets" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="Summary" Foreground="{StaticResource TextDim}" FontSize="11" Margin="12,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" Width="28" Height="28" HorizontalAlignment="Right"
                        ToolTip="{local:T De=Schließen, En=Close}" />
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="7" Background="#10FFFFFF" Padding="8,0" Height="28">
                    <Grid>
                        <TextBlock x:Name="SearchHint" Text="{local:T De='Pet oder Monster suchen …', En='Search pet or monster …'}" Foreground="{StaticResource TextDim}"
                                   FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                                 FontSize="11.5" VerticalAlignment="Center" TextChanged="Search_Changed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="HideFullChip" Style="{StaticResource Chip}" Height="28" Click="HideFull_Click" Margin="0,0,6,0"
                            Content="{local:T De='Volle ausblenden', En='Hide full'}" />
                    <Button x:Name="ChestChip" Style="{StaticResource Chip}" Height="28" Click="Chest_Click"
                            ToolTip="{local:T De='Pets, deren Seelen nur aus Truhen kommen', En='Pets whose souls only come from chests'}"
                            Content="{local:T De='Nur-Truhen-Pets', En='Chest-only pets'}" />
                </StackPanel>
            </Grid>

            <!-- Here in the area: the monsters of this map that drop souls you still need, those in view first -->
            <Border x:Name="AreaPanel" DockPanel.Dock="Top" CornerRadius="10" Background="#0E7FD8F2" BorderBrush="#287FD8F2" BorderThickness="1"
                    Padding="12,8,12,4" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AreaTitle" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AreaOnlyChip" Style="{StaticResource Chip}" Height="24" HorizontalAlignment="Right" Click="AreaOnly_Click"
                                ToolTip="{local:T De='Die Liste unten nur mit Pets, die auf dieser Karte droppen', En='The list below with only the pets that drop on this map'}"
                                Content="{local:T De='Liste: nur dieses Gebiet', En='List: this area only'}" />
                    </Grid>
                    <TextBlock x:Name="AreaEmpty" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AreaList" ItemTemplate="{StaticResource AreaTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Note" DockPanel.Dock="Top" Foreground="#E8B04B" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,8" Visibility="Collapsed" />

            <Grid DockPanel.Dock="Top" Margin="12,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:T De='PET · WO ES DROPPT', En='PET · WHERE IT DROPS'}" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{local:T De=STUFE, En=LEVEL}" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{local:T De=SEELEN, En=SOULS}" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{local:T De='BIS ST. 3', En='TO LV 3'}" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" ItemTemplate="{StaticResource PetTemplate}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
