<Window x:Class="PeakMeter.TicketProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter – Energie &amp; Tickets lernen" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,16">
        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" Foreground="#FF6B81" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{local:T De='Energie &amp; Tickets lernen', En='Learn energy &amp; tickets'}" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right"
                        Width="28" Height="28" ToolTip="{local:T De='Schließen', En='Close'}" />
            </Grid>

            <TextBlock x:Name="StepText" Foreground="{StaticResource TextSoft}" FontSize="11.5" TextWrapping="Wrap" LineHeight="18" />

            <!-- Odyle energy as the game shows it: "0 (+475) / 840" -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IcoOdyle" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="Odyle" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3"
                        ToolTip="{local:T De='Die erste Zahl, z. B. 0 bei „0 (+475) / 840“', En='The first number, e.g. 0 in “0 (+475) / 840”'}">
                    <TextBox x:Name="InPool" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
                <TextBlock Grid.Column="2" Text="(+" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Center" Margin="8,0,6,0" />
                <Border Grid.Column="3" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3"
                        ToolTip="{local:T De='Die Zahl in Klammern, z. B. 475', En='The number in brackets, e.g. 475'}">
                    <TextBox x:Name="InBonus" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
            </Grid>

            <!-- the five counters as the game shows them -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IcoNightmare" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{local:T De=Albtraum, En=Nightmare}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3">
                    <TextBox x:Name="InNightmare" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IcoAscension" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{local:T De=Aszensusritus, En=Ascension}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="1" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3">
                    <TextBox x:Name="InAscension" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IcoDaily" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{local:T De='Täglicher Dungeon', En='Daily dungeon'}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="2" Grid.Column="1" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3">
                    <TextBox x:Name="InDaily" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IcoShugo" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{local:T De=Shugo-Schlüssel, En='Shugo key'}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="3" Grid.Column="1" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3">
                    <TextBox x:Name="InShugo" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
                <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IcoInvasion" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{local:T De=Invasions-Schlüssel, En='Invasion key'}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="4" Grid.Column="1" CornerRadius="6" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,3">
                    <TextBox x:Name="InInvasion" Style="{StaticResource Field}" KeyDown="Input_KeyDown" />
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="MainButton" Style="{StaticResource Chip}" Height="28" Click="Main_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MainIcon" Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" Foreground="#FF6B81" />
                        <TextBlock x:Name="MainLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource Chip}" Height="28" Margin="8,0,0,0" Click="Save_Click">
                    <TextBlock x:Name="SaveLabel" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
