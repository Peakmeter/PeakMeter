<Window x:Class="PeakMeter.TicketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter – Tickets" Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <!-- one character row: name block + six ticket columns -->
        <DataTemplate x:Key="CharTemplate">
            <Grid Height="52" Margin="0,0,0,3">
                <Border x:Name="Bg" CornerRadius="8" Background="#0AFFFFFF" />
                <Border CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left" Background="{Binding ClassBrush}" />
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Seen}" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="Odyle" Text="{Binding Odyle}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Gain}" Foreground="{StaticResource Accent}" FontSize="11" Margin="4,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Nightmare}" Style="{DynamicResource Cell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Ascension}" Style="{DynamicResource Cell}" />
                    <TextBlock Grid.Column="4" Text="{Binding Daily}" Style="{DynamicResource Cell}" />
                    <TextBlock Grid.Column="5" Text="{Binding ShugoKey}" Style="{DynamicResource Cell}" />
                    <TextBlock Grid.Column="6" Text="{Binding InvasionKey}" Style="{DynamicResource Cell}" />
                    <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Remove_Click" Opacity="0.45"
                            ToolTip="{local:T De='Aus der Liste entfernen', En='Remove from the list'}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#147FD8F2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Full}" Value="True">
                    <Setter TargetName="Odyle" Property="Foreground" Value="#FFB070" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a server group: header line, then its characters -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                    <TextBlock Text="{Binding Server}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                    <Border CornerRadius="5" Background="#227FD8F2" Padding="7,1" Margin="10,0,0,0" Visibility="{Binding QuaiVisible}">
                        <TextBlock Text="{Binding QuaiText}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CharTemplate}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Style.Triggers>
                <Trigger Property="Text" Value="–">
                    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Head" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14">
        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Tickets" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,8,0" Click="Energy_Click"
                            ToolTip="{local:T De='Energie von Hand korrigieren, Quai-Mitgliedschaft', En='Correct the energy by hand, Quai membership'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" Margin="0,1,6,0" />
                            <TextBlock Text="{local:T De='Energie anpassen', En='Adjust energy'}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Chip}" Height="26" Margin="0,0,8,0" Click="Learn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" Foreground="#FF6B81" Margin="0,1,6,0" />
                            <TextBlock Text="{local:T De='Tickets lernen', En='Learn tickets'}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" Width="28" Height="28" ToolTip="{local:T De=Schließen, En=Close}" />
                </StackPanel>
            </Grid>

            <!-- column heads with icons -->
            <Grid Margin="12,0,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:T De=CHARAKTER, En=CHARACTER}" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                <StackPanel Grid.Column="1" Style="{StaticResource Head}">
                    <Image x:Name="IcoOdyle" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Text="Odyle" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource Head}">
                    <Image x:Name="IcoNightmare" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T De=Albtraum, En=Nightmare}" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource Head}">
                    <Image x:Name="IcoAscension" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T De=Aszensusritus, En=Ascension}" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Style="{StaticResource Head}">
                    <Image x:Name="IcoDaily" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T De='Tägl. Dungeon', En='Daily dungeon'}" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="5" Style="{StaticResource Head}">
                    <Image x:Name="IcoShugo" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T De=Shugo-Schlüssel, En='Shugo key'}" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="6" Style="{StaticResource Head}">
                    <Image x:Name="IcoInvasion" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:T De=Invasions-Schl., En='Invasion key'}" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="Groups" ItemTemplate="{StaticResource GroupTemplate}" />
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap" Margin="4,6,4,6" />

            <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="2,10,2,0">
                <StackPanel>
                    <TextBlock x:Name="ResetText" Foreground="{StaticResource TextSoft}" FontSize="11" />
                    <TextBlock x:Name="EstimateText" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock x:Name="FullText" Foreground="#FFB070" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock x:Name="LearnText" Foreground="{StaticResource TextDim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
