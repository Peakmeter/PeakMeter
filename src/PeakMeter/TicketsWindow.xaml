<Window x:Class="PeakMeter.TicketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter – Tickets" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="CharTemplate">
            <Grid Height="50" Margin="0,0,0,3">
                <Border x:Name="Bg" CornerRadius="8" Background="#0AFFFFFF" />
                <Border CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left" Background="{Binding ClassBrush}" />
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="N" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Seen}" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="Odyle" Text="{Binding Odyle}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Gain}" Foreground="{StaticResource Accent}" FontSize="11" Margin="5,1,0,0"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Remove_Click"
                            ToolTip="{local:T De='Charakter aus der Liste entfernen', En='Remove character from the list'}" Opacity="0.5" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#147FD8F2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Full}" Value="True">
                    <Setter TargetName="Odyle" Property="Foreground" Value="#FFB070" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14">
        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Tickets" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                    <Border x:Name="QuaiBadge" CornerRadius="5" Background="#227FD8F2" Padding="7,1" Margin="10,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{local:T De=Quai-Mitgliedschaft, En='Quai membership'}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right"
                        Width="28" Height="28" ToolTip="{local:T De=Schließen, En=Close}" />
            </Grid>

            <!-- column heads -->
            <Grid Margin="12,0,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:T De=CHARAKTER, En=CHARACTER}" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="#B07CF0" FontSize="11" Margin="0,1,5,0" />
                    <TextBlock Text="ODYLE" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="List" ItemTemplate="{StaticResource CharTemplate}" />
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap" Margin="4,6,4,6"
                       Text="{local:T De='Noch keine Charaktere. Log dich mit PeakMeter im Hintergrund ein – jeder Charakter, den du spielst, erscheint hier.', En='No characters yet. Log in with PeakMeter running – every character you play shows up here.'}" />

            <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="2,10,2,0">
                <StackPanel>
                    <TextBlock x:Name="ResetText" Foreground="{StaticResource TextSoft}" FontSize="11" />
                    <TextBlock x:Name="FullText" Foreground="#FFB070" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{local:T De='+ = seit dem letzten Spielen hochgerechnet (+15 alle 3 Std.). Weitere Tickets (Albtraum, Aszensus, Schlüssel …) folgen, sobald PeakMeter sie im Spiel gelernt hat.', En='+ = estimated since you last played (+15 every 3 h). More tickets (Nightmare, Ascension, keys …) follow once PeakMeter has learned them from the game.'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
