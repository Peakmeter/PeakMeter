<Window x:Class="PeakMeter.Overlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        MinWidth="220" MaxWidth="520" Width="300"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">


    <Grid>
        <Border x:Name="Root" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="12" Padding="10,8,10,10">
            <StackPanel>
                <!-- Header: fight title, sub line, clock; toolbar on hover -->
                <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" MouseWheel="Header_Wheel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
                    <Grid x:Name="SelfBadge" Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="SelfRing" StrokeThickness="1.5" />
                        <Image x:Name="SelfIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="PeakMeter" Foreground="{StaticResource Text}" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubText" Text="{local:T De='Bereit', En='Ready'}" Foreground="{StaticResource TextDim}" FontSize="10.5"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="Toolbar" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,4,0">
                            <Button x:Name="OpacityButton" Style="{StaticResource IconButton}" Content="&#xE706;" Click="Opacity_Click"
                                    ToolTip="{local:T De='Transparenz einstellen', En='Transparency'}" />
                            <Popup x:Name="OpacityPopup" PlacementTarget="{Binding ElementName=OpacityButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" HorizontalOffset="-90">
                                <Border Background="#FA0D0F15" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="10"
                                        Padding="12,10" Width="210">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{local:T De='Hintergrund', En='Background'}" Foreground="{StaticResource Text}" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="{StaticResource TextSoft}" FontSize="11"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{local:T De='durchsichtig', En='clear'}" Foreground="{StaticResource TextDim}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource Slim}" Minimum="20" Maximum="100"
                                                    LargeChange="10" SmallChange="5" IsMoveToPointEnabled="True" ValueChanged="OpacitySlider_Changed" />
                                            <TextBlock Grid.Column="2" Text="{local:T De='deckend', En='solid'}" Foreground="{StaticResource TextDim}" FontSize="9.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{local:T De='Schrift bleibt immer gut lesbar. Auch: Strg + Mausrad.', En='Text always stays readable. Also: Ctrl + mouse wheel.'}" Foreground="{StaticResource TextDim}"
                                                   FontSize="9.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button x:Name="ViewChip" Style="{StaticResource Chip}" Content="DPS" Height="20" Margin="0,0,2,0"
                                    Click="View_Click" ToolTip="{local:T De='Schaden / Heilung / erlittener Schaden', En='Damage / healing / damage taken'}" />
                            <Button x:Name="ModeChip" Style="{StaticResource Chip}" Content="BOSS" Height="20" Margin="0,0,2,0"
                                    Click="Mode_Click" ToolTip="{local:T De='Nur Boss-Schaden / alles zählen', En='Boss damage only / count everything'}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="Older_Click" ToolTip="{local:T De='Älterer Kampf (auch Mausrad)', En='Older fight (also mouse wheel)'}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="Newer_Click" ToolTip="{local:T De='Neuerer Kampf / Live', En='Newer fight / live'}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="Copy_Click" ToolTip="{local:T De='Ergebnis für den Chat kopieren', En='Copy result for the chat'}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE722;" Click="CopyImage_Click" ToolTip="{local:T De='Bild für Discord kopieren (dort Strg+V)', En='Copy picture for Discord (paste with Ctrl+V)'}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reset_Click" ToolTip="{local:T De='Zurücksetzen (Strg+Shift+R)', En='Reset'}" />
                            <Button x:Name="LockButton" Style="{StaticResource IconButton}" Content="&#xE785;" Click="Lock_Click" ToolTip="{local:T De='Position sperren', En='Lock position'}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Hide_Click" ToolTip="{local:T De='Verstecken (Strg+Shift+D)', En='Hide'}" />
                        </StackPanel>
                        <TextBlock x:Name="ClockText" Text="0:00" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="2,0,2,0" />
                    </StackPanel>
                </Grid>

                <!-- Boss HP -->
                <Grid x:Name="HpPanel" Margin="2,8,2,2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HpTrack" Height="5" CornerRadius="2.5" Background="{StaticResource Track}" VerticalAlignment="Center">
                        <Border x:Name="HpFill" HorizontalAlignment="Left" CornerRadius="2.5" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF4D6D" Offset="0" />
                                    <GradientStop Color="#FF9F59" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock x:Name="HpText" Grid.Column="1" Text="100%" Foreground="{StaticResource TextSoft}" FontSize="10.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <!-- HP left and when the boss will be down at the current pace -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3,0,0">
                        <TextBlock x:Name="HpAmount" Foreground="{StaticResource TextDim}" FontSize="10.5" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="KillText" Foreground="{StaticResource TextSoft}" FontSize="10.5" HorizontalAlignment="Right"
                                   Typography.NumeralAlignment="Tabular" ToolTip="{local:T De='Geschätzt aus dem Schaden der letzten 20 Sekunden', En='Estimated from the damage of the last 20 seconds'}" />
                    </Grid>
                </Grid>

                <!-- You against your last fight with this boss, and the best kill time -->
                <StackPanel x:Name="ComparePanel" Orientation="Horizontal" Margin="2,6,2,0" Visibility="Collapsed">
                    <TextBlock x:Name="CompareArrow" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock x:Name="CompareText" Foreground="{StaticResource TextSoft}" FontSize="10.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="BestText" Foreground="{StaticResource TextDim}" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Pets: the souls of the monster you fight, or the ones you just picked up -->
                <Border x:Name="PetPanel" Visibility="Collapsed" Margin="2,6,2,0" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Pet_Click" ToolTip="{local:T De='Pet-Seelen: Klick zeigt alle Pets', En='Pet souls: click for all pets'}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource PawIcon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PetText" Foreground="{StaticResource TextSoft}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Players -->
                <ItemsControl x:Name="Rows" Margin="0,8,0,0" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"
                              PreviewMouseLeftButtonUp="Rows_Click" />

                <!-- Empty / status -->
                <TextBlock x:Name="EmptyText" Margin="2,10,2,4" Foreground="{StaticResource TextDim}" FontSize="11.5"
                           TextWrapping="Wrap" TextAlignment="Center" Text="{local:T De='Warte auf den ersten Treffer …', En='Waiting for the first hit …'}" />

                <!-- Party: level, gear score, combat power of every member -->
                <Border x:Name="PartyPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="0,8,0,0"
                        BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="10,0,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PartyTitle" Text="{local:T De='Gruppe', En='Party'}" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" Margin="-8,0,0,0" />
                            <TextBlock Grid.Column="1" Text="GS" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="2" Text="CP" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <ItemsControl x:Name="PartyList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24" Margin="0,0,0,2">
                                        <Border CornerRadius="5" Background="{StaticResource Track}" />
                                        <Border CornerRadius="5,0,0,5" Width="3" HorizontalAlignment="Left" Background="{Binding ClassBrush}" />
                                        <Grid Margin="8,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="N" Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextSoft}" FontSize="11.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock x:Name="R" Text="{Binding ReadyMark}" Foreground="#6FD48A" FontSize="11.5" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Level}" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Gear}" Foreground="{StaticResource Text}" FontSize="11.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="4" Text="{Binding Power}" Foreground="{StaticResource TextSoft}" FontSize="11.5"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NotReady}" Value="True">
                                            <Setter TargetName="R" Property="Foreground" Value="#E5736B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter TargetName="N" Property="Foreground" Value="White" />
                                            <Setter TargetName="N" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PartySummary" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="2,4,2,0" />
                    </StackPanel>
                </Border>

                <!-- Selected player's skills -->
                <Border x:Name="DetailPanel" Visibility="Collapsed" Margin="0,6,0,0" Padding="0,8,0,0"
                        BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailTitle" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="ProfileButton" Style="{StaticResource Chip}" Margin="8,0,0,0" Height="20" Click="Profile_Click" VerticalAlignment="Center"
                                        ToolTip="{local:T De='PeakMeter-Profil: Ausrüstung, Werte, Daevanion, Skills und die besten Kills', En='PeakMeter profile: gear, stats, Daevanion, skills and the best kills'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,5,0" />
                                        <TextBlock Text="{local:T De=Profil, En=Profile}" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="DetailStats" HorizontalAlignment="Right" Foreground="{StaticResource TextDim}" FontSize="10.5"
                                       Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <TextBlock x:Name="IdleText" Foreground="{StaticResource TextSoft}" FontSize="10.5" Margin="2,0,2,4" Visibility="Collapsed"
                                   ToolTip="{local:T De='Zeit ohne eigenen Treffer (Pausen über 2,5 s, ohne DoTs) – Tod, Laufen und Phasen ohne Ziel zählen mit', En='Time without an own hit (pauses over 2.5 s, DoTs excluded) – deaths, running and phases without a target count too'}" />
                        <TextBlock x:Name="DeathText" Foreground="#FF8A8A" FontSize="10.5" Margin="2,0,2,6" TextWrapping="Wrap" Visibility="Collapsed"
                                   ToolTip="{local:T De='Die stärksten Treffer der letzten 8 Sekunden vor dem Tod', En='The hardest hits of the last 8 seconds before the death'}" />
                        <ItemsControl x:Name="Skills" ItemTemplate="{StaticResource SkillTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- Event alert banner -->
                <Border x:Name="Banner" Visibility="Collapsed" Margin="0,8,0,0" CornerRadius="8" Padding="10,7"
                        Background="#267FD8F2" BorderBrush="#557FD8F2" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonUp="Banner_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Text}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="BannerText" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="460"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Footer: next event, logs, timers -->
                <Grid Margin="2,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Timers_Click"
                                ToolTip="{local:T De='Event-Timer öffnen', En='Open event timers'}" VerticalAlignment="Center">
                        <TextBlock x:Name="NextIcon" Text="&#xE916;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextDim}"
                                   FontSize="10.5" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock x:Name="NextText" Foreground="{StaticResource TextDim}" FontSize="10.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="EnergyButton" Style="{StaticResource IconButton}" Width="Auto" Height="20" Padding="5,0" Click="Energy_Click"
                                ToolTip="{local:T De='Odyle-Energie', En='Odyle energy'}">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="10.5" VerticalAlignment="Center" Margin="0,1,4,0" />
                                <TextBlock x:Name="EnergyText" Text="–" FontFamily="{StaticResource UiFont}" FontSize="10.5" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="PingPanel" Orientation="Horizontal" Margin="2,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"
                                    ToolTip="{local:T De='Ping zum Spielserver, aus dem Datenverkehr gemessen', En='Ping to the game server, measured from the traffic'}">
                            <TextBlock x:Name="PingIcon" Text="&#xEC3B;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Margin="0,1,4,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PingText" FontSize="10.5" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" Click="Tickets_Click" ToolTip="Tickets" Height="20" />
                        <Button x:Name="PetsButton" Style="{StaticResource IconButton}" Click="PetsButton_Click" Height="20" ToolTip="{local:T De='Pets: Seelen-Sammlung', En='Pets: soul collection'}">
                            <Image Source="{StaticResource PawIcon}" Width="12" Height="12" />
                        </Button>
                        <Button x:Name="PartyButton" Style="{StaticResource IconButton}" Content="&#xE716;" Click="Party_Click" ToolTip="{local:T De='Gruppe: Gearscore und Combat Power', En='Party: gear score and combat power'}" Height="20" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="{local:T De='Einstellungen', En='Settings'}" Height="20" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE81C;" Click="Logs_Click" ToolTip="{local:T De='Logs (gespeicherte Kämpfe)', En='Logs (saved fights)'}" Height="20" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE916;" Click="Timers_Click" ToolTip="{local:T De='Event-Timer', En='Event timers'}" Height="20" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Class colour glow along the top edge (own class, once known) -->
        <Border x:Name="ClassGlow" Height="2" VerticalAlignment="Top" Margin="22,1,22,0" CornerRadius="1" Visibility="Collapsed"
                IsHitTestVisible="False" />

        <!-- Width grip on the right edge -->
        <Thumb x:Name="Grip" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" DragDelta="Grip_Drag"
               DragCompleted="Grip_Done" />
    </Grid>
</Window>
