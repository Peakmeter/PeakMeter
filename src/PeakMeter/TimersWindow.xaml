<Window x:Class="PeakMeter.TimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeakMeter"
        Title="PeakMeter – Event-Timer" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Topmost="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="EventTemplate">
            <Grid x:Name="Row" Height="44" Margin="0,0,0,3">
                <Border x:Name="Bg" CornerRadius="8" Background="#0AFFFFFF" />
                <Border x:Name="Live" CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left" Background="#3FD18B" Visibility="Collapsed" />
                <Grid Margin="6,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Bell" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="14" Content="&#xE7ED;"
                            Click="Bell_Click" ToolTip="{local:T De='Klingelton an/aus', En='Chime on/off'}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Schedule}" Foreground="{StaticResource TextDim}" FontSize="10.5" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="Count" Text="{Binding Countdown}" Foreground="{StaticResource Text}" FontSize="13.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding At}" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Alert}" Value="True">
                    <Setter TargetName="Bell" Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter TargetName="Bell" Property="Content" Value="&#xEA8F;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Alert}" Value="False">
                    <Setter TargetName="Bell" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter TargetName="Live" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Count" Property="Foreground" Value="#3FD18B" />
                    <Setter TargetName="Bg" Property="Background" Value="#103FD18B" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BossTemplate">
            <Grid Height="40" Margin="0,0,0,3">
                <Border x:Name="Bg" CornerRadius="8" Background="#0AFFFFFF" />
                <Border x:Name="Live" CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left" Background="#3FD18B" Visibility="Collapsed" />
                <Grid Margin="6,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Bell" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE7ED;"
                            Click="BossBell_Click" ToolTip="{local:T De='Klingelton vor dem Respawn an/aus', En='Chime before respawn on/off'}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Sub}" Foreground="{StaticResource TextDim}" FontSize="10" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="Count" Text="{Binding Countdown}" Foreground="{StaticResource Text}" FontSize="12.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding At}" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0" Content="&#xE8FB;"
                            Click="Killed_Click" ToolTip="{local:T De='Gerade getötet – Countdown jetzt starten', En='Just killed – start the countdown now'}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Watch}" Value="True">
                    <Setter TargetName="Bell" Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter TargetName="Bell" Property="Content" Value="&#xEA8F;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Watch}" Value="False">
                    <Setter TargetName="Bell" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Alive}" Value="True">
                    <Setter TargetName="Live" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Count" Property="Foreground" Value="#3FD18B" />
                    <Setter TargetName="Bg" Property="Background" Value="#103FD18B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Known}" Value="False">
                    <Setter TargetName="Count" Property="Foreground" Value="{StaticResource TextDim}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="14,12,14,14">
        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseDown" Margin="2,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{local:T De='Event-Timer', En='Event timers'}" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right"
                        Width="28" Height="28" ToolTip="{local:T De='Schließen', En='Close'}" />
            </Grid>

            <!-- Tabs -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                <Button x:Name="EventsTab" Style="{StaticResource Chip}" Content="EVENTS" Height="24" Margin="0,0,4,0" Click="Tab_Click" Tag="events" />
                <Button x:Name="BossesTab" Style="{StaticResource Chip}" Content="{local:T De='WELTBOSSE', En='WORLD BOSSES'}" Height="24" Click="Tab_Click" Tag="bosses" />
            </StackPanel>

            <StackPanel x:Name="EventsPanel">
                <TextBlock x:Name="ErrorText" Foreground="#FF6B81" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,8" Visibility="Collapsed" />
                <ItemsControl x:Name="List" ItemTemplate="{StaticResource EventTemplate}" />
            </StackPanel>

            <StackPanel x:Name="BossesPanel" Visibility="Collapsed">
                <Border CornerRadius="8" Background="#147FD8F2" Padding="10,7" Margin="0,0,0,8">
                    <TextBlock Foreground="{StaticResource TextSoft}" FontSize="10.5" TextWrapping="Wrap"
                               Text="{local:T De='Tipp: Öffne im Spiel Karte → Erkundung → Feldmonster. Dann übernimmt PeakMeter die genauen Respawn-Zeiten direkt vom Server. Kills in deiner Nähe startet er von selbst.', En='Tip: open Map → Exploration → Field monsters in the game. PeakMeter then takes the exact respawn times from the server. Kills near you start by themselves.'}" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                    <Button x:Name="RegAll" Style="{StaticResource Chip}" Content="{local:T De='ALLE', En='ALL'}" Height="22" Margin="0,0,4,0" Click="Region_Click" Tag="" />
                    <Button x:Name="RegV" Style="{StaticResource Chip}" Content="VERTERON" Height="22" Margin="0,0,4,0" Click="Region_Click" Tag="Verteron" />
                    <Button x:Name="RegA" Style="{StaticResource Chip}" Content="ALTGARD" Height="22" Click="Region_Click" Tag="Altgard" />
                </StackPanel>
                <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl x:Name="BossList" ItemTemplate="{StaticResource BossTemplate}" />
                </ScrollViewer>
            </StackPanel>

            <!-- Sound -->
            <Grid Margin="2,12,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextDim}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider x:Name="Volume" Grid.Column="1" Style="{StaticResource Slim}" Minimum="0" Maximum="100" LargeChange="10"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="Volume_Changed"
                        Thumb.DragCompleted="Volume_Done" PreviewMouseLeftButtonUp="Volume_Up" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" Foreground="{StaticResource TextSoft}" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                <Button Grid.Column="3" Style="{StaticResource Chip}" Height="24" Margin="10,0,0,0" Click="Test_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                        <TextBlock Text="{local:T De='Testen', En='Test'}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="2,12,2,0">
                <TextBlock x:Name="NoteText" Foreground="{StaticResource TextDim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,120,0"
                           Text="{local:T De='EU-Zeiten aus der Community (NCSoft veröffentlicht keine). Stimmt etwas nicht? Einfach anpassen.', En='EU times from the community (NCSOFT publishes none). Something off? Just edit them.'}" />
                <Button x:Name="EditButton" Style="{StaticResource Chip}" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Edit_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                        <TextBlock Text="{local:T De='Zeiten bearbeiten', En='Edit times'}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
